# =============================================================================
# .env  -  DEZVOLTARE LOCALA (docker-compose.yaml + docker-compose.dev.yml)
#
#   cp .env.example .env        (PowerShell: Copy-Item .env.example .env)
#   scripts/dev-up.ps1          (sau scripts/dev-up.sh)
#
# Valorile de mai jos sunt pentru dev local, NU le folosi in productie
# (pentru prod: .env.prod.example). Fisierul .env e in .gitignore.
#
# Porturile DEV_* se pot schimba aici daca sunt ocupate pe masina ta; atunci
# PUBLIC_URL si FILES_PUBLIC_URL trebuie sa foloseasca acelasi DEV_HTTP_PORT.
# =============================================================================

# Numele proiectului compose: prefix pentru containere/volume/retea.
# Diferit de prod, ca stack-urile sa nu se amestece pe aceeasi masina.
COMPOSE_PROJECT_NAME=fbi-dev

# -----------------------------------------------------------------------------
# URL-uri publice (ce vede BROWSERUL)
# -----------------------------------------------------------------------------
# Adresa la care deschizi aplicatia. Portul trebuie sa fie == DEV_HTTP_PORT.
# Folosim "localhost" (context securizat -> Geolocation API merge pe HTTP).
# Se coace in bundle-ul frontend (NEXT_PUBLIC_*) -> schimbarea cere rebuild.
PUBLIC_URL=http://localhost:8088

# Baza URL-urilor pozelor urcate (salvate in DB, afisate in browser).
# python-ai descarca pozele prin nginx intern: overlay-ul de dev ii da
# IMAGE_URL_REWRITE="${PUBLIC_URL}=>http://nginx" (localhost din container e
# containerul insusi). Portul trebuie sa fie == DEV_HTTP_PORT. Folosit de: file-api.
FILES_PUBLIC_URL=http://localhost:8088/files

# -----------------------------------------------------------------------------
# PostgreSQL  (folosit de: db, keycloak, backend, python-ai)
# -----------------------------------------------------------------------------
DB_USER=fbi
DB_PASSWORD=dev_db_password
# Baza aplicatiei (tabele EF Core; python-ai scrie direct in ea)
DB_NAME=fbi
# Baza Keycloak (creata de postgres-init/script.sh la primul start)
KEYCLOAK_DB_NAME=keycloak

# -----------------------------------------------------------------------------
# RabbitMQ  (folosit de: rabbitmq, backend, python-ai)
# -----------------------------------------------------------------------------
RABBITMQ_USER=fbi
RABBITMQ_PASSWORD=dev_rabbit_password
# Coada backend -> python-ai (AnalyzeFaceCommand). Fara prefixul "queue:".
RABBITMQ_QUEUE_ANALYSIS=face-analysis-queue
# Coada python-ai -> backend (rezultat analiza)
RABBITMQ_QUEUE_FINISHED=analysis-finished-queue

# -----------------------------------------------------------------------------
# MinIO  (folosit de: minio, file-api)
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=fbi_minio
# Minim 8 caractere (altfel MinIO nu porneste)
MINIO_ROOT_PASSWORD=dev_minio_password
# Bucket-ul pozelor; creat automat (cu citire publica) la primul upload
MINIO_BUCKET=fbi-evidence
# Imaginea S3 (minio/minio oficial nu mai e publicat; implicit Silo, fork-ul
# comunitar pgsty compatibil MinIO). Optional, doar daca vrei alta versiune.
# MINIO_IMAGE=docker.io/pgsty/silo:RELEASE.2026-10-26T00-00-00Z

# -----------------------------------------------------------------------------
# Keycloak  (folosit de: keycloak, backend)
# -----------------------------------------------------------------------------
# Admin-ul din realm-ul master (consola: http://localhost:18080/admin/).
# Creat DOAR la primul start; schimbarea ulterioara nu are efect.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=dev_admin_password
# Realm-ul si clientul aplicatiei. Importate automat din
# keycloak/realm-export.json la primul start (placeholder-e ${...}).
KEYCLOAK_REALM=dotnet
KEYCLOAK_CLIENT_ID=dotnet
# Secretul clientului: Keycloak il ia din import, backend-ul il foloseste
# la login. Trebuie sa fie acelasi in ambele -> vine din aceasta variabila.
KEYCLOAK_CLIENT_SECRET=dev_client_secret_change_me

# -----------------------------------------------------------------------------
# Chei intre servicii
# -----------------------------------------------------------------------------
# Cheia X-Api-Key pentru POST /upload (file-api). Este copiata automat si in
# frontend ca NEXT_PUBLIC_FILE_API_KEY (ajunge in bundle-ul din browser!).
API_KEY_SHARED=dev_shared_upload_key
# Cheia X-FBI-Key pentru python-ai /fast-search (folosita de backend)
FACE_RECOG_API_KEY=dev_face_recog_key

# -----------------------------------------------------------------------------
# Importul FBI (backend, FbiScraperService; ruleaza apoi o data la 24h)
# -----------------------------------------------------------------------------
# auto   = la pornire doar daca tabela WantedPersons e goala (baza noua)
# always = la fiecare pornire a backend-ului
# never  = doar la 24h dupa pornire
SCRAPER_RUN_AT_STARTUP=auto

# -----------------------------------------------------------------------------
# Serviciul AI  (folosit de: python-ai)
# -----------------------------------------------------------------------------
# true = la pornire sincronizeaza indexul facial cu "WantedImages" (vezi
# SYNC_MAX_PERSONS). Implicit false; foloseste scripts/sync-faces.sh.
RUN_SYNC_AT_STARTUP=false
# Cate persoane recunoaste aplicatia: sync-ul indexeaza O poza per persoana
# (prima cu fata detectabila), pentru primele N persoane dupa Id. Scraper-ul
# importa oricum toate persoanele. 0 sau gol = fara limita (toate pozele).
SYNC_MAX_PERSONS=100
# Ce afise FBI (poster_classification) sunt recunoscute. Gol = implicit, doar
# persoanele cautate: default,ten,terrorist,fraudster,crimes-against-children,
# kidnapping,law-enforcement-assistance,ecap (fara victime si fara afisele
# ViCAP de persoane disparute/neidentificate). "*" = toate afisele.
SYNC_INCLUDE_CLASSIFICATIONS=
# Latura maxima a unei poze inainte de detectia fetei (RAM). 0 = fara limita.
IMAGE_MAX_SIDE=1280
# Pauza intre descarcarile de poze ale sync-ului (ms)
SYNC_DELAY_MS=200
# Cate persoane (sau poze, fara limita) proceseaza sync-ul intre doua salvari
# ale indexului. Implicit 50.
SYNC_BATCH_SIZE=50
# Pauzele (secunde) dintre reincercarile unei descarcari esuate (retea, 429, 5xx).
# "5,15" = 3 incercari; gol = fara reincercari.
SYNC_RETRY_DELAYS=5,15

# -----------------------------------------------------------------------------
# Nginx
# -----------------------------------------------------------------------------
# Dimensiunea maxima a unui upload de poza (format nginx: 20m, 50m...)
UPLOAD_MAX_SIZE=20m

# -----------------------------------------------------------------------------
# Porturi de debug pe host (doar dev). Default-uri alese sa nu se bata cu
# containere standalone pe porturile standard.
# -----------------------------------------------------------------------------
# nginx -> aplicatia (== portul din PUBLIC_URL/FILES_PUBLIC_URL)
DEV_HTTP_PORT=8088
# Postgres (pt. dotnet ef / DBeaver / python pe host)
DEV_DB_PORT=15433
# Keycloak (consola admin)
DEV_KEYCLOAK_PORT=18080
# RabbitMQ AMQP
DEV_RABBITMQ_AMQP_PORT=15674
# RabbitMQ management UI
DEV_RABBITMQ_MGMT_PORT=15673
# MinIO S3 API
DEV_MINIO_API_PORT=19000
# MinIO consola
DEV_MINIO_CONSOLE_PORT=19001
# backend direct (Swagger: /swagger)
DEV_BACKEND_PORT=17002
# file-api direct
DEV_FILE_API_PORT=17005
# python-ai direct (/docs)
DEV_AI_PORT=18006
# Next.js direct
DEV_FRONTEND_PORT=13000

# -----------------------------------------------------------------------------
# Integrari NEFOLOSITE de feature-urile curente (backend). Pot ramane goale.
# -----------------------------------------------------------------------------
STRIPE_PUB_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK=
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SUPABASE_URL=
SUPABASE_KEY=
