# =============================================================================
# .env.prod  -  PRODUCTIE pe VPS (docker-compose.yaml + docker-compose.prod.yml)
#
#   cp .env.prod.example .env.prod && chmod 600 .env.prod
#   nano .env.prod                  # completeaza TOATE valorile CHANGE_ME
#   scripts/init-ssl.sh             # prima data: certificat Let's Encrypt
#   scripts/prod-deploy.sh
#
# .env.prod e in .gitignore. Nu-l commite niciodata.
# Genereaza secretele cu:  openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
# Evita caracterele $ si " in valori (compose le interpreteaza).
# =============================================================================

COMPOSE_PROJECT_NAME=fbi

# -----------------------------------------------------------------------------
# Domeniu  (folosit de: nginx, keycloak, frontend, file-api, init-ssl)
# -----------------------------------------------------------------------------
# Domeniul public, FARA https:// si fara slash. Inregistrarea DNS A (si
# optional www) trebuie sa indice IP-ul VPS-ului inainte de init-ssl.
# Din el se deriva: https://DOMAIN/api, /hubs/surveillance, /upload, /files,
# KC_HOSTNAME. prod-deploy si init-ssl refuza sa porneasca cu example.com.
DOMAIN=example.com

# Email-ul pentru Let's Encrypt (notificari de expirare). Folosit de init-ssl.
CERTBOT_EMAIL=CHANGE_ME@example.com

# -----------------------------------------------------------------------------
# PostgreSQL  (folosit de: db, keycloak, backend, python-ai)
# -----------------------------------------------------------------------------
DB_USER=fbi
DB_PASSWORD=CHANGE_ME
DB_NAME=fbi
KEYCLOAK_DB_NAME=keycloak

# -----------------------------------------------------------------------------
# RabbitMQ  (folosit de: rabbitmq, backend, python-ai)
# -----------------------------------------------------------------------------
RABBITMQ_USER=fbi
RABBITMQ_PASSWORD=CHANGE_ME
RABBITMQ_QUEUE_ANALYSIS=face-analysis-queue
RABBITMQ_QUEUE_FINISHED=analysis-finished-queue

# -----------------------------------------------------------------------------
# MinIO  (folosit de: minio, file-api)
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=fbi_minio
# Minim 8 caractere
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_BUCKET=fbi-evidence
# Imaginea S3 (implicit Silo, fork compatibil MinIO; vezi docs). Optional.
# MINIO_IMAGE=docker.io/pgsty/silo:RELEASE.2026-10-26T00-00-00Z

# -----------------------------------------------------------------------------
# Keycloak  (folosit de: keycloak, backend)
# -----------------------------------------------------------------------------
# Admin-ul temporar din realm-ul master, creat doar la primul start.
# Dupa primul login creeaza un admin permanent si sterge-l pe acesta (docs/prod).
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
KEYCLOAK_REALM=dotnet
KEYCLOAK_CLIENT_ID=dotnet
# Importat in Keycloak la primul start SI folosit de backend la login.
# Daca il schimbi dupa import, actualizeaza-l si in consola Keycloak
# (Clients -> <client> -> Credentials), altfel login-ul pica.
KEYCLOAK_CLIENT_SECRET=CHANGE_ME

# -----------------------------------------------------------------------------
# Chei intre servicii
# -----------------------------------------------------------------------------
# X-Api-Key pentru /upload. Copiata automat in frontend ca
# NEXT_PUBLIC_FILE_API_KEY -> e VIZIBILA in browser (vezi security checklist).
API_KEY_SHARED=CHANGE_ME
# X-FBI-Key pentru python-ai /fast-search (backend -> python-ai, intern)
FACE_RECOG_API_KEY=CHANGE_ME

# -----------------------------------------------------------------------------
# Importul FBI (backend, FbiScraperService; ruleaza apoi o data la 24h)
# -----------------------------------------------------------------------------
# auto   = la pornire doar daca tabela WantedPersons e goala (baza noua)
# always = la fiecare pornire a backend-ului
# never  = doar la 24h dupa pornire
SCRAPER_RUN_AT_STARTUP=auto

# -----------------------------------------------------------------------------
# Serviciul AI
# -----------------------------------------------------------------------------
# Lasa false; reconstruirea indexului se face la cerere cu scripts/sync-faces.sh
RUN_SYNC_AT_STARTUP=false
# Cate persoane recunoaste aplicatia: sync-ul indexeaza O poza per persoana
# (prima cu fata detectabila), pentru primele N persoane dupa Id. Scraper-ul
# importa oricum toate persoanele. 0 sau gol = fara limita (toate pozele).
SYNC_MAX_PERSONS=100
# Ce afise FBI (poster_classification) sunt recunoscute. Gol = implicit, doar
# persoanele cautate: default,ten,terrorist,fraudster,crimes-against-children,
# kidnapping,law-enforcement-assistance,ecap (fara victime si fara afisele
# ViCAP de persoane disparute/neidentificate). "*" = toate afisele.
SYNC_INCLUDE_CLASSIFICATIONS=
# Latura maxima a unei poze inainte de detectia fetei (RAM). 0 = fara limita.
IMAGE_MAX_SIDE=1280
# Pauza intre descarcarile de poze ale sync-ului (ms)
SYNC_DELAY_MS=200
# Cate persoane (sau poze, fara limita) proceseaza sync-ul intre doua salvari
# ale indexului. Implicit 50.
SYNC_BATCH_SIZE=50
# Limita de memorie a containerului python-ai (masurat: ~650 MiB, varf ~850 MiB la sync)
AI_MEMORY_LIMIT=2g
# Limita de memorie Keycloak (JVM-ul foloseste ~70% din ea ca heap)
KEYCLOAK_MEMORY_LIMIT=1g

# -----------------------------------------------------------------------------
# Nginx
# -----------------------------------------------------------------------------
UPLOAD_MAX_SIZE=20m

# -----------------------------------------------------------------------------
# Porturi pentru tunel SSH, legate DOAR pe 127.0.0.1 al VPS-ului:
#   ssh -L 18080:127.0.0.1:18080 -L 19001:127.0.0.1:19001 -L 15673:127.0.0.1:15673 user@vps
# apoi pe laptop: http://localhost:18080/admin/ (Keycloak),
# http://localhost:19001 (MinIO), http://localhost:15673 (RabbitMQ).
# Portul local al tunelului Keycloak trebuie sa fie acelasi (KC_HOSTNAME_ADMIN).
# -----------------------------------------------------------------------------
KC_ADMIN_TUNNEL_PORT=18080
MINIO_CONSOLE_TUNNEL_PORT=19001
RABBITMQ_MGMT_TUNNEL_PORT=15673

# -----------------------------------------------------------------------------
# Backup  (folosit de: scripts/backup.sh, rulat zilnic de scripts/install-cron.sh)
# -----------------------------------------------------------------------------
# Cate backup-uri locale (backups/<timestamp>/) se pastreaza
BACKUP_KEEP=7
# Copie off-site optionala cu rclone, format <remote>:<cale> (ex. b2:fbi-backups,
# s3:bucket/fbi, gdrive:backups/fbi). Gol = doar local. Remote-ul se configureaza
# o data cu: docker run --rm -it -v ~/.config/rclone:/config/rclone rclone/rclone:1.75.2 config
BACKUP_REMOTE=
# Cate backup-uri se pastreaza in remote (gol = la fel ca BACKUP_KEEP)
BACKUP_REMOTE_KEEP=
# Folderul cu rclone.conf (gol = ~/.config/rclone)
RCLONE_CONFIG_DIR=

# -----------------------------------------------------------------------------
# Integrari NEFOLOSITE de feature-urile curente (backend). Pot ramane goale.
# -----------------------------------------------------------------------------
STRIPE_PUB_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK=
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SUPABASE_URL=
SUPABASE_KEY=
