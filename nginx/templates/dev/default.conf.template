# ============================================================================
# Nginx DEV - HTTP simplu, fara TLS. Publicat pe host la ${DEV_HTTP_PORT}
# (implicit http://localhost:8088). Variabile din env: ${UPLOAD_MAX_SIZE}
# Keycloak, consola MinIO si RabbitMQ se acceseaza direct pe porturile de
# debug (vezi docker-compose.dev.yml), nu prin nginx.
# ============================================================================


# Resolver Docker + proxy_pass prin variabile (adresele: snippets/upstream-vars.conf)
include /etc/nginx/snippets/upstreams.conf;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

map $upstream_http_content_type $files_disposition {
    ~*^image/svg  "attachment";
    ~*^image/     "";
    default       "attachment";
}

server {
    listen 80 default_server;
    server_name _;

    include /etc/nginx/snippets/upstream-vars.conf;

    client_max_body_size 2m;

    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /api/ {
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_pass $upstream_backend;
    }

    location /hubs/ {
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_pass $upstream_backend;
        proxy_buffering off;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    location /upload {
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_pass $upstream_file_api;
        client_max_body_size ${UPLOAD_MAX_SIZE};
    }

    location /files/ {
        limit_except GET HEAD { deny all; }
        include /etc/nginx/snippets/proxy-headers.conf;
        # /files/<bucket>/<obiect> -> /<bucket>/<obiect> la MinIO. Cu proxy_pass
        # prin variabila, prefixul se elimina cu rewrite (nu cu URI in proxy_pass).
        rewrite ^/files/(.*)$ /$1 break;
        proxy_pass $upstream_minio;
        proxy_buffering off;
        include /etc/nginx/snippets/files-security.conf;
    }

    location / {
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_pass $upstream_frontend;
    }
}
